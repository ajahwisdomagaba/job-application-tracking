# Existing application configuration
MONGODB_URI=mongodb://127.0.0.1:27017/job-application-tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# SMTP email confirmation configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Job Application Tracker <no-reply@example.com>
# Public API base URL used to build confirmation links
API_BASE_URL=http://localhost:5000
