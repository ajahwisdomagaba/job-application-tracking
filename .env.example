PORT=5000
NODE_ENV=development

# MongoDB (Must support replica sets for atomic status updates)
MONGODB_URI=mongodb://localhost:27017/jobtracker?replicaSet=rs0

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret
JWT_EXPIRES_IN=7d
EMAIL_CONFIRM_TOKEN_EXPIRES_HOURS=24

# Cloudinary (Raw file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=job-tracker/attachments
MAX_ATTACHMENT_SIZE_MB=10
SIGNED_LINK_TTL_SECONDS=300

# Email Service (Nodemailer / Mailtrap)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM="Job Tracker <no-reply@jobtracker.com>"

# Initial Administrator Setup (Dedicated script)
ADMIN_EMAIL=superadmin@jobtracker.com
ADMIN_PASSWORD=SuperAdminPassword123!
ADMIN_NAME="System Administrator"
