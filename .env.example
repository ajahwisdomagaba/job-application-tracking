PORT=5000
NODE_ENV=development

# MongoDB. MONGO_URI is accepted as a fallback name.
MONGODB_URI=mongodb://127.0.0.1:27017/job-application-tracker

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary private raw-file storage.
# Values that are empty or start with your_ are treated as not configured.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=job-tracker/attachments
MAX_ATTACHMENT_SIZE_MB=5
SIGNED_LINK_TTL_SECONDS=300

# SMTP. Leave blank until mail is ready. Confirmation, stage notices, and reminders use these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Job Application Tracker <no-reply@example.com>
# Must use the same host and port as PORT. Confirmation links are built from this.
API_BASE_URL=http://localhost:5000

# One-time admin created by npm run setup:admin. Password must be at least 8 characters.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_at_least_8_characters

# Shared password for the sample recruiters created by npm run seed. At least 8 characters.
SEED_RECRUITER_PASSWORD=replace_with_at_least_8_characters
