MONGODB_URI=mongodb://127.0.0.1:27017/job-application-tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# Cloudinary private raw-file storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=job-tracker/attachments
MAX_ATTACHMENT_SIZE_MB=5
SIGNED_LINK_TTL_SECONDS=300

# SMTP email confirmation configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Job Application Tracker <no-reply@example.com>
API_BASE_URL=http://localhost:5000
